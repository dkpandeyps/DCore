  "binary_binding": {
    "authoritative": [
      "exact executable SHA-256 read (bytes only) from the certified installation inside an L4-isolated cert env (CONTROLLED/INDEPENDENT_OBSERVATION)"
    ],
    "insufficient": [
      "filename",
      "directory/path",
      "package.json version",
      "benchmark binary reference",
      "registry metadata"
    ],
    "open_gap": "OPEN DESIGN GAP — an embedded version resource binding is unproven for Claude Code; the exact-byte-hash path exists but its authority depends on L4 cert-env control (see GAP-02)",
    "rule": "binary_sha256 must identify the EXACT certified executable; supporting sources may corroborate but never substitute",
    "supporting_only": [
      "package/archive hash",
      "embedded version metadata (UNPROVEN)"
    ]
  },
  "channel_binding": {
    "design_candidates": [
      {
        "acceptable_if": "CONTROLLED_OBSERVATION recorded machine-readably",
        "candidate": "controlled-install attestation (channel deliberately installed in the cert env)"
      },
      {
        "acceptable_if": "INDEPENDENT_OBSERVATION",
        "candidate": "independent observer of the installed channel"
      }
    ],
    "forbidden_inference": [
      "version",
      "filename",
      "path",
      "OS",
      "architecture",
      "benchmark pin",
      "registry profile",
      "install date",
      "history"
    ],
    "open_gap": "OPEN DESIGN GAP — no concrete machine-readable channel evidence source is proven for Claude Code (see GAP-01)",
    "rule": "channel must be DIRECTLY evidenced (>= CONTROLLED_OBSERVATION); SELF_REPORTED insufficient; never inferred"
  },
