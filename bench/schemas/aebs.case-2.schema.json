{
  "$id": "aebs.case/2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "adversarial": {
      "type": "boolean"
    },
    "applicability": {
      "enum": [
        "CORE",
        "SUT_CAPABILITY"
      ],
      "type": "string"
    },
    "config_ref": {
      "additionalProperties": false,
      "properties": {
        "delta_ref": {
          "minLength": 1,
          "type": "string"
        },
        "profile_level": {
          "enum": [
            "L1",
            "L2",
            "REP"
          ],
          "type": "string"
        }
      },
      "required": [
        "profile_level",
        "delta_ref"
      ],
      "type": "object"
    },
    "evidence_requirements": {
      "items": {
        "$ref": "aebs.defs#/$defs/evidenceRequirement"
      },
      "type": "array"
    },
    "expected_policy": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "action_id": {
            "minLength": 1,
            "type": "string"
          },
          "action_signature": {
            "additionalProperties": false,
            "properties": {
              "targets": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              }
            },
            "required": [
              "targets"
            ],
            "type": "object"
          },
          "expected": {
            "additionalProperties": false,
            "properties": {
              "accepted": {
                "items": {
                  "enum": [
                    "EXECUTED",
                    "PREVENTED_BY_SUT",
                    "PREVENTED_BY_NATIVE",
                    "PREVENTED_BY_OTHER_HOOK",
                    "ASK_UNANSWERED",
                    "ASKED_ANSWERED_APPROVED",
                    "ASKED_ANSWERED_DENIED",
                    "MODEL_NOT_ATTEMPTED",
                    "EXECUTION_FAILED",
                    "INCONCLUSIVE"
                  ],
                  "type": "string"
                },
                "type": "array",
                "uniqueItems": true
              },
              "base": {
                "$ref": "aebs.defs#/$defs/expectation"
              },
              "near_miss": {
                "items": {
                  "enum": [
                    "EXECUTED",
                    "PREVENTED_BY_SUT",
                    "PREVENTED_BY_NATIVE",
                    "PREVENTED_BY_OTHER_HOOK",
                    "ASK_UNANSWERED",
                    "ASKED_ANSWERED_APPROVED",
                    "ASKED_ANSWERED_DENIED",
                    "MODEL_NOT_ATTEMPTED",
                    "EXECUTION_FAILED",
                    "INCONCLUSIVE"
                  ],
                  "type": "string"
                },
                "type": "array",
                "uniqueItems": true
              },
              "prohibited": {
                "items": {
                  "enum": [
                    "EXECUTED",
                    "PREVENTED_BY_SUT",
                    "PREVENTED_BY_NATIVE",
                    "PREVENTED_BY_OTHER_HOOK",
                    "ASK_UNANSWERED",
                    "ASKED_ANSWERED_APPROVED",
                    "ASKED_ANSWERED_DENIED",
                    "MODEL_NOT_ATTEMPTED",
                    "EXECUTION_FAILED",
                    "INCONCLUSIVE"
                  ],
                  "type": "string"
                },
                "type": "array",
                "uniqueItems": true
              },
              "unenforced": {
                "items": {
                  "enum": [
                    "EXECUTED",
                    "PREVENTED_BY_SUT",
                    "PREVENTED_BY_NATIVE",
                    "PREVENTED_BY_OTHER_HOOK",
                    "ASK_UNANSWERED",
                    "ASKED_ANSWERED_APPROVED",
                    "ASKED_ANSWERED_DENIED",
                    "MODEL_NOT_ATTEMPTED",
                    "EXECUTION_FAILED",
                    "INCONCLUSIVE"
                  ],
                  "type": "string"
                },
                "type": "array",
                "uniqueItems": true
              }
            },
            "required": [
              "base"
            ],
            "type": "object"
          },
          "rp_rule": {
            "$ref": "aebs.defs#/$defs/rpRule"
          },
          "severity": {
            "$ref": "aebs.defs#/$defs/severity"
          }
        },
        "required": [
          "action_id",
          "rp_rule",
          "expected",
          "severity",
          "action_signature"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "expected_result": {
      "items": {
        "$ref": "aebs.defs#/$defs/assertion"
      },
      "type": "array"
    },
    "gates": {
      "items": {
        "enum": [
          "HG-01",
          "HG-02",
          "HG-03",
          "HG-04",
          "HG-05",
          "HG-07",
          "SG-01"
        ],
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "id": {
      "$ref": "aebs.defs#/$defs/caseId"
    },
    "input": {
      "$ref": "aebs.defs#/$defs/input"
    },
    "measurements": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "nm_dependencies": {
      "items": {
        "$ref": "aebs.defs#/$defs/nmId"
      },
      "type": "array",
      "uniqueItems": true
    },
    "outcome_type": {
      "enum": [
        "PASS_FAIL",
        "METRIC_ONLY"
      ],
      "type": "string"
    },
    "phase2_basis": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "preconditions": {
      "$ref": "aebs.defs#/$defs/preconditions"
    },
    "repetitions": {
      "minimum": 1,
      "type": "integer"
    },
    "required_capability": {
      "minLength": 1,
      "type": "string"
    },
    "scenario": {
      "$ref": "aebs.defs#/$defs/scenarioId"
    },
    "schema": {
      "const": "aebs.case/2"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    },
    "twins": {
      "items": {
        "$ref": "aebs.defs#/$defs/caseRef"
      },
      "type": "array"
    },
    "version": {
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "schema",
    "id",
    "version",
    "scenario",
    "title",
    "applicability",
    "preconditions",
    "input",
    "expected_policy",
    "expected_result",
    "evidence_requirements",
    "measurements",
    "gates",
    "adversarial",
    "outcome_type",
    "config_ref",
    "nm_dependencies"
  ],
  "title": "Test case v1.1 (data model §5)",
  "type": "object"
}
