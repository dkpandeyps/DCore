      "outcome": "reject load"
    },
    {
      "behavior": "FAIL_CLOSED",
      "condition": "tampered package",
      "outcome": "reject (integrity failure)"
    },
    {
      "behavior": "FAIL_CLOSED",
      "condition": "unknown capability",
