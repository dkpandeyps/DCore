      "id": "D-07"
    },
    {
      "blocker": "defined in spec; created only at install time, not this phase",
      "boundary": "BUILD_LATER",
      "description": "runtime state directory location + on-disk format",
      "id": "D-08"
    },
    {
      "blocker": null,
      "boundary": "BUILD_LATER",
      "description": "update/migration executor",
      "id": "D-09"
    },
    {
      "blocker": "offline-first default; remote refresh policy needs owner decision",
