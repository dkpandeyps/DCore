{
  "$id": "aebs.policy_decision/2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action_id": {
      "minLength": 1,
      "type": "string"
    },
    "attempt_id": {
      "pattern": "^att_[0-9A-HJKMNP-TV-Z]{26}$",
      "type": "string"
    },
    "decision": {
      "enum": [
        "EXECUTED",
        "PREVENTED",
        "ASKED",
        "UNKNOWN",
        "NOT_ATTEMPTED"
      ],
      "type": "string"
    },
    "decision_id": {
      "pattern": "^pdc_[0-9A-HJKMNP-TV-Z]{26}$",
      "type": "string"
    },
    "layer": {
      "pattern": "^(native_rule|native_path|native_protected|native_shell_analysis|validation|ask_unanswered|sut_reported|unknown|hook:sut:.+|hook:foreign:.+|hook:unattributed)$",
      "type": "string"
    },
    "matched_attribution_rule": {
      "minLength": 1,
      "type": "string"
    },
    "schema": {
      "const": "aebs.policy_decision/2"
    },
    "source_events": {
      "items": {
        "pattern": "^tev_[0-9A-HJKMNP-TV-Z]{26}$",
        "type": "string"
      },
      "type": "array"
    },
    "tool_use_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema",
    "decision_id",
    "attempt_id",
    "action_id",
    "decision",
    "layer",
    "source_events"
  ],
  "title": "Policy decision v1.1 (data model §5)",
  "type": "object"
}
