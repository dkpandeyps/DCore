  "additionalProperties": false,
  "properties": {
    "cli_allowed_tools": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "cli_args": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "declared_capabilities": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "description": {
      "minLength": 1,
      "type": "string"
    },
    "foreign_hooks_ref": {
      "minLength": 1,
      "type": "string"
    },
    "id": {
