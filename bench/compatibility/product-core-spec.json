    },
    {
      "behavior": "FAIL_CLOSED",
      "condition": "adapter failure",
      "outcome": "UNSUPPORTED/UNVERIFIED; refuse"
    },
    {
      "behavior": "FAIL_CLOSED",
      "condition": "runtime failure",
      "outcome": "abort safely; clean up; report"
