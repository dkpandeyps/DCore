{
  "adapter_contract": {
    "core_contains_platform_behavior": false,
    "interface_id": "dkskill.platform_adapter_contract/1",
    "may_provide": [
      "host identity",
      "OS normalization",
      "architecture detection",
      "runtime facts",
      "platform-specific safe operations",
      "platform-specific capability evidence"
    ],
    "must_not": [
      "declare certification",
      "assume behavior",
      "access credentials",
      "bypass M3/M4/M8/M9"
    ]
  },
  "capabilities": [
    {
      "capability_id": "CAP-COMPAT-RESOLVE",
      "depends_on_m0_capability": null,
      "min_state": "VERIFIED",
      "name": "compatibility resolution",
      "operations": [
        "OP-RESOLVE-COMPAT",
        "OP-DIAGNOSE"
      ],
      "safety_critical": true
    },
    {
      "capability_id": "CAP-ENV-DETECT",
      "depends_on_m0_capability": null,
      "min_state": "VERIFIED",
      "name": "environment detection",
      "operations": [
        "OP-DETECT-ENV"
      ],
      "safety_critical": false
    }
  ],
  "compatibility_api": [
    {
      "fail_closed": true,
      "fn": "detectEnvironment()",
      "inputs": [
        "local OS/arch/version/channel"
      ],
      "maps_to": "platform-adapter.selectAdapter + host probe",
      "output": "UniversalHost",
      "purity": [
        "ENVIRONMENT_DEPENDENT",
        "ADAPTER_DEPENDENT"
      ]
    },
    {
      "fail_closed": true,
      "fn": "resolveHostIdentity()",
      "inputs": [
        "UniversalHost"
      ],
      "maps_to": "universal-compatibility.normalizeHost",
      "output": "HostIdentity",
      "purity": [
        "ADAPTER_DEPENDENT",
        "DETERMINISTIC_OVER_INPUTS"
      ]
    },
    {
      "fail_closed": true,
      "fn": "resolveCompatibility()",
      "inputs": [
        "HostIdentity",
        "registry"
      ],
      "maps_to": "universal-compatibility.resolveUniversal (M3 HCL)",
      "output": "UserCompatibilityResult",
      "purity": [
        "REGISTRY_DEPENDENT",
        "DETERMINISTIC_OVER_INPUTS"
      ]
    },
    {
      "fail_closed": true,
      "fn": "resolveCapabilities()",
      "inputs": [
        "profile"
      ],
      "maps_to": "M3 resolveCapabilities",
      "output": "CapabilityRow[]",
      "purity": [
        "REGISTRY_DEPENDENT",
        "DETERMINISTIC_OVER_INPUTS"
      ]
    },
    {
      "fail_closed": true,
      "fn": "resolveFacets()",
      "inputs": [
        "profile",
        "registry"
      ],
      "maps_to": "M3 resolveFacets",
      "output": "FacetRow[]",
      "purity": [
        "REGISTRY_DEPENDENT",
        "DETERMINISTIC_OVER_INPUTS"
      ]
    },
    {
      "fail_closed": true,
      "fn": "resolvePermissions()",
      "inputs": [
        "operation"
      ],
      "maps_to": "product permission model (unknown=DENY)",
      "output": "PermissionStatus",
      "purity": [
        "DETERMINISTIC_OVER_INPUTS"
      ]
    },
    {
      "fail_closed": true,
      "fn": "enforceCompatibility()",
      "inputs": [
        "UserCompatibilityResult",
        "level"
      ],
      "maps_to": "M3 decideEnforcement",
      "output": "EnforcementDecision",
      "purity": [
        "DETERMINISTIC_OVER_INPUTS"
      ]
    },
    {
      "fail_closed": true,
      "fn": "enforceSecurity()",
      "inputs": [
        "manifest",
        "registry",
        "evidence"
      ],
      "maps_to": "M6 signed registry + M13 security model",
      "output": "allow/deny",
      "purity": [
        "DETERMINISTIC_OVER_INPUTS"
      ]
    }
  ],
  "current_state": {
    "attr_valid_for": "2.1.283",
    "current_real_host": "UNVERIFIED",
