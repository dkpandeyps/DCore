          },
          "seq": {
            "minimum": 0,
            "type": "integer"
          },
          "session_id": {
            "minLength": 1,
            "type": "string"
          },
          "subtype": {
            "minLength": 1,
            "type": "string"
          },
          "type": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "seq",
          "rx_ms",
          "type"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "executable_path": {
      "minLength": 1,
      "type": "string"
    },
    "exit_code": {
      "type": [
        "integer",
