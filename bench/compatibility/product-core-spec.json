  "responsibilities": {
    "adapters": [
      "normalize host identity per platform",
      "expose only establishable evidence",
      "never declare certification"
    ],
    "capabilities": [
      "depend on stable M0 capability IDs",
      "never upgrade NOT_YET_VALIDATED to VERIFIED"
    ],
    "compatibility": [
      "resolve exact profile via M3",
      "refuse enforcement on UNVERIFIED (H-Q1)"
    ],
    "configuration": [
      "read user config; safe defaults; unknown => safe"
    ],
    "core_runtime": [
      "discover/load/validate the product",
      "run the universal lifecycle",
      "fail closed on any unsafe ambiguity"
    ],
    "failure": [
      "every unsafe ambiguity fails closed with an actionable explanation"
    ],
    "installation": [
      "platform-neutral clone/discover/validate/install/initialize/compatibility-check"
    ],
    "security": [
      "verify integrity/signature",
      "no secrets",
      "fail closed"
    ],
    "update": [
      "no automatic inheritance; new releases UNVERIFIED"
    ]
  },
